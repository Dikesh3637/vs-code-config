{
  "chat.commandCenter.enabled": false,
  "workbench.navigationControl.enabled": false,
  "window.commandCenter": false,
  "workbench.colorTheme": "Catppuccin Mocha",
  "editor.fontFamily": "JetBrainsMono NF",
  "editor.lineHeight": 1.6,
  "editor.wordWrap": "off",
  "editor.minimap.enabled": false,
  "json.validate.enable": false,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "window.customTitleBarVisibility": "windowed",
  "editor.minimap.enabled": false,
  "redhat.telemetry.enabled": true,
  "terminal.integrated.defaultProfile.windows": "JavaSE-24",
  "terminal.integrated.fontFamily": "monospace",
  "[java]": {
    "editor.defaultFormatter": "redhat.java"
  },
  "editor.formatOnSave": true,
  "remote.autoForwardPortsSource": "hybrid",
  "workbench.activityBar.location": "top",
  "editor.wordWrapColumn": 60,
  "window.newWindowProfile": "Default",
  "git.openRepositoryInParentFolders": "always",
  "github.copilot.nextEditSuggestions.enabled": true,
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
    "java": true,
    "xml": false,
    "javascript": true
  },
  "workbench.sideBar.location": "right",
  "workbench.editor.restoreViewState": false,
  "diffEditor.wordWrap": "off",
  "editor.codeLens": false,

  // neovim extension
  "vscode-neovim.useWSL": true,
  "vscode-neovim.neovimExecutablePaths.linux": "/home/linuxbrew/.linuxbrew/bin/nvim",
  "remote.extensionKind": {
    "asvetliakov.vscode-neovim": ["workspace"]
  },
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1
  },
  "vscode-neovim.neovimInitVimPaths.linux": "/home/dikesh/.config/nvim-vscode/init.lua"
